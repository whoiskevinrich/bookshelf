{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "cdk.out/.ts",
    // CDK types use optional properties that can be undefined, which is
    // incompatible with exactOptionalPropertyTypes: true in the base config.
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  "include": ["bin", "lib", "test"]
}
