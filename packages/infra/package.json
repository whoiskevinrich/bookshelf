{
  "name": "@bookshelf/infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint bin && eslint lib",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@bookshelf/api": "workspace:*",
    "@bookshelf/mcp": "workspace:*",
    "@bookshelf/web": "workspace:*",
    "@types/node": "^25.9.4",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "aws-cdk": "^2.1128.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
