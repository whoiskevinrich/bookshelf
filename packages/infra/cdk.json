{
  "app": "npx tsx bin/bookshelf.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk/aws-cloudfront-origins:useDistributionUrlForS3CanonicalUser": true,
    "@aws-cdk/aws-cognito:enableStandardAttributesByDefault": true,
    "@aws-cdk/core:enableAdditionalMetadataCollection": false
  }
}
