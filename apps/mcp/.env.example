# Cognito — from AuthStack CloudFormation exports after `cdk deploy`
# (AuthStack publishes CFN exports, not SSM params, for these values)
# aws cloudformation list-exports --region us-west-2 --query "Exports[?Name=='BookshelfUserPoolIssuer'].Value"  --output text
# aws cloudformation list-exports --region us-west-2 --query "Exports[?Name=='BookshelfMcpClientId'].Value"     --output text
# aws cloudformation list-exports --region us-west-2 --query "Exports[?Name=='BookshelfHostedUiBaseUrl'].Value" --output text
# NOTE: COGNITO_CLIENT_ID must be the *mcp* client (BookshelfMcpClientId), not the SPA client.
COGNITO_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_HOSTED_UI_BASE_URL=https://bookshelf-xxxxxxxxxxxx.auth.us-west-2.amazoncognito.com

# API URL — use the local dev API for local MCP dev, or the deployed URL
# aws ssm get-parameter --name /bookshelf/api/url --query Parameter.Value --output text --region us-west-2
API_BASE_URL=http://localhost:3001

# MCP server public URL — used in OAuth discovery documents
MCP_SERVER_URL=http://localhost:3002

# AWS region — required when not set in ~/.aws/config
# AWS_REGION=us-west-2
