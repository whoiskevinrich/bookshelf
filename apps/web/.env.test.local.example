# Playwright E2E credentials — copy to apps/web/.env.test.local (gitignored).
#
# Use a DEDICATED, dev-only Cognito user in the green dev pool
# (us-west-2_NxOrdblYM). Never a personal or prod account — the blast radius of
# this credential is dev data only, and you rotate it in Cognito if it leaks.
#
# These are read Node-side by playwright.config.ts. They are intentionally NOT
# VITE_-prefixed, so they are never inlined into the browser bundle. Keep the
# real password here (in the gitignored .env.test.local) or in your password
# manager — never in source, never in a VITE_ var.
#
# In CI, set TEST_USER_EMAIL / TEST_USER_PASSWORD as repository secrets instead
# of committing this file's filled-in copy.

TEST_USER_EMAIL=qa-dev@example.com
TEST_USER_PASSWORD=

# Optional overrides (defaults shown):
# APP_BASE_URL=http://localhost:3000
# API_BASE_URL=http://localhost:3001
