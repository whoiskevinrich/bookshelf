# Cognito — values from AuthStack SSM outputs after `cdk deploy`
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# Cognito Hosted UI domain (no scheme) — REQUIRED for Google/social sign-in
# (signInWithRedirect). Without it the "Continue with Google" button fails.
# Dev value: bookshelf-058308164167-g2.auth.us-west-2.amazoncognito.com
VITE_COGNITO_OAUTH_DOMAIN=xxxxxxxx.auth.us-east-1.amazoncognito.com

# API — local dev: http://localhost:3001
#       deployed:  value from ApiStack SSM output /bookshelf/api/url
VITE_API_BASE_URL=http://localhost:3001

# Set to "true" to show the "Source on GitHub" link on /about (e.g. once the repo is made public)
# VITE_SHOW_REPO_LINK=false

# Local QA convenience (dev only): prefill the login email field so QA against the
# real Cognito pool skips retyping it on every reload. Email only — NEVER put a
# password in a VITE_ var (Vite inlines VITE_* into the client bundle). An
# import.meta.env.DEV guard strips this from production builds. Set in .env.local.
# VITE_QA_EMAIL=qa-dev@example.com
