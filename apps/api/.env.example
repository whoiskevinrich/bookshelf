# Cognito — from AuthStack SSM outputs after `cdk deploy`
# aws ssm get-parameter --name /bookshelf/cognito/user-pool-id --query Parameter.Value --output text --region us-west-2
# aws ssm get-parameter --name /bookshelf/cognito/client-id   --query Parameter.Value --output text --region us-west-2
COGNITO_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB — table name from ApiStack (default: bookshelf)
DYNAMODB_TABLE_NAME=bookshelf

# Book provider — defaults to google-books if unset
# BOOK_PROVIDER=google-books
# GOOGLE_BOOKS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
