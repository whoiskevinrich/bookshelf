{
  "name": "@bookshelf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "validate:covers": "node --import tsx/esm scripts/validate-covers.ts",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/server.ts",
    "db:seed": "node --env-file=.env.local --import tsx/esm scripts/seed-local.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/parameters": "^2.33.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.838.0",
    "@aws-sdk/client-dynamodb": "^3.838.0",
    "@aws-sdk/client-ssm": "^3.1060.0",
    "@aws-sdk/lib-dynamodb": "^3.838.0",
    "@hono/node-server": "^2.0.4",
    "hono": "^4.7.11",
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^25.9.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.12",
    "kill-port": "^2.0.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
