{
  "permissions": {
    "allow": ["mcp__f12d29f1-7911-4d01-b15d-14d731852426__createJiraIssue"]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "aws-core@agent-toolkit-for-aws": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "echo \"[pre-pr-docs] Before submitting this PR, confirm documentation is up to date: (1) Technical decisions -> docs/adrs/<slug>.md  (2) Feature specs / spec changes -> docs/specs/<slug>.md  (3) System operations (scripts, infra, env setup) -> docs/runbooks/<slug>.md\"",
            "shell": "powershell",
            "async": false,
            "statusMessage": "Checking documentation requirements..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$PWD\" in *.claude/worktrees/*) MAIN=\"G:/source/bookshelf\"; for f in apps/api/.env.local apps/web/.env.local; do [ -f \"$MAIN/$f\" ] && [ ! -f \"$f\" ] && cp \"$MAIN/$f\" \"$f\" && echo \"Copied: $f\"; done ;; esac",
            "shell": "bash",
            "async": false,
            "statusMessage": "Copying .env.local files into worktree..."
          },
          {
            "type": "command",
            "command": "pnpm install",
            "shell": "bash",
            "async": true,
            "statusMessage": "Installing dependencies..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-toolkit-for-aws": {
      "source": {
        "source": "github",
        "repo": "aws/agent-toolkit-for-aws"
      }
    }
  }
}
