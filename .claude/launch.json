{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bookshelf/web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bookshelf/api", "run", "dev"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "api-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:api:local"],
      "port": 3001,
      "autoPort": false
    }
  ]
}
