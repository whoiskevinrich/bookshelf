{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bookshelf/web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": ["-File", "scripts/dev-api.ps1"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "live-server",
        "todo",
        "--port=5501",
        "--no-browser",
        "--entry-file=dashboard.html"
      ],
      "port": 5501,
      "autoPort": false
    }
  ]
}
