{
  "name": "bookshelf",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && node --test \"scripts/**/*.test.mjs\"",
    "test:coverage": "pnpm -r test:coverage",
    "deploy:infra": "pnpm --filter @bookshelf/infra run deploy",
    "synth": "pnpm --filter ./packages/infra/** run synth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa:guards": "node scripts/qa-guards.mjs",
    "preflight": "pnpm format && pnpm lint && pnpm test && pnpm qa:guards && pnpm synth",
    "prepare": "husky",
    "dev": "pnpm -r dev"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
