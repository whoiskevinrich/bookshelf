{
  "name": "bookshelf",
  "version": "0.1.31",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "deploy:infra": "pnpm --filter @bookshelf/infra run deploy",
    "synth": "pnpm --filter ./packages/infra/** run synth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:bump": "npm version patch --no-git-tag-version",
    "preflight": "pnpm format && pnpm lint && pnpm test && pnpm synth",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
